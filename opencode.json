{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modal",
      "options": {
        "baseURL": "https://api.us-west-2.modal.direct/v1",
        "apiKey": "{env:MODAL_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.1-FP8": {
          "name": "GLM-5.1"
        }
      }
    },
    "z-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_CODING_API_KEY}",
        "timeout": 600000,
        "setCacheKey": true
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "options": { "reasoningEffort": "low" },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3-FLASH",
          "options": { 
            "reasoning_effort": "max",
            "temperature": 1,
            "top_p": 0.95
          }
        }
      }
    },
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "minimax/minimax-m3:free": {
          "name": "MiniMax M3 (Free)",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "z-ai/glm-5.3",
  "default_agent": "build",
  "compaction": { "auto": false, "prune": true, "reserved": 40000 },
  "plugin": ["opencode-dynamic-context-pruning"],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "list": "allow",
    "task": "ask",
    "skill": "allow",
    "webfetch": "ask",
    "question": "allow"
  },
  "mcp": {
    "echovault": {
      "type": "local",
      "command": ["memory", "mcp"],
      "timeout": 5000,
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "timeout": 15000,
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "timeout": 15000,
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "timeout": 8000,
      "enabled": true
    },
    "scrapling": {
      "type": "local",
      "command": ["scrapling", "mcp"],
      "timeout": 30000,
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.9.0", "--isolated", "--headless", "--no-usage-statistics"],
      "timeout": 30000,
      "enabled": true
    }
  },
  "tools": {
    "echovault_*": false,
    "context7_*": false,
    "sequential-thinking_*": false,
    "gh_grep_*": false,
    "scrapling_*": false,
    "chrome-devtools_*": false
  },
  "agent": {
    "build": {
      "description": "Course content agent: Markdown lessons, pedagogy rules, link integrity. MCPs off (lazy via subagents).",
      "tools": {
        "echovault_*": true,
        "context7_*": true,
        "chrome-devtools_*": true
      },
      "permission": {
        "bash": {
          "python3 -m unittest*": "allow",
          "python3 -m json.tool*": "allow",
          "rg *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add *": "allow",
          "git stash*": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git checkout *": "ask",
          "git reset *": "ask",
          "git rebase*": "ask",
          "git branch*": "ask",
          "rm *": "deny",
          "rm -rf *": "deny",
          "*": "ask"
        }
      },
      "steps": 20
    },
    "plan": {
      "description": "Read-only planning with course context (docs/pedagogy.md, docs/adr/). Uses sequential-thinking for multi-step refactors.",
      "tools": { "echovault_*": true, "sequential-thinking_*": true, "context7_*": true },
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "adversary": {
      "description": "Hostile reviewer for plan-agent output. Verifies claims against memory, docs (CONTEXT.md, docs/pedagogy.md, docs/adr/), and code, then returns a verdict plus a corrected plan. Read-only.",
      "mode": "primary",
      "steps": 30,
      "tools": {
        "echovault_*": true,
        "sequential-thinking_*": true,
        "context7_*": true,
        "gh_grep_*": true
      },
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "skill": "allow",
        "task": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow"
      }
    },
    "doc-curator": {
      "description": "Subagent for researching current library and API docs before content or code is written. Uses context7 + gh_grep, no edits.",
      "mode": "subagent",
      "hidden": true,
      "tools": { "context7_*": true, "gh_grep_*": true },
      "permission": { "edit": "deny", "bash": "deny", "webfetch": "allow" }
    }
  },
  "instructions": ["./AGENTS.md"],
  "watcher": {
    "ignore": [
      ".git/**",
      "graphify-out/**",
      "**/graphify-out/**",
      "node_modules/**",
      "**/node_modules/**",
      ".ruff_cache/**",
      "**/__pycache__/**",
      "*.png",
      "*.jpg"
    ]
  },
  "lsp": true,
  "formatter": true,
  "snapshot": true,
  "autoupdate": true
}
